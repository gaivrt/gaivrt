---
/**
 * Entrance — the particle "GAIVRT" laid over the homepage, once per browser session.
 * The inline script decides before first paint, so the homepage never flashes through:
 * it counts the visit, and shows the overlay unless a returning visitor gets to skip it.
 */
import ParticleEntrance from './ParticleEntrance.tsx';
import { ENTRANCE } from '../../lib/constants';

const skipAfter = ENTRANCE.SKIP_THRESHOLD;
const reappear = ENTRANCE.REAPPEAR_CHANCE;
---

<script is:inline define:vars={{ skipAfter, reappear }}>
  (function() {
    try {
      if (sessionStorage.getItem('gaivrt_entered')) return;
      sessionStorage.setItem('gaivrt_entered', '1');
      const KEY = 'gaivrt_visits';
      const raw = localStorage.getItem(KEY);
      const data = raw ? JSON.parse(raw) : { count: 0, firstVisit: Date.now(), lastVisit: Date.now() };
      data.count++;
      data.lastVisit = Date.now();
      localStorage.setItem(KEY, JSON.stringify(data));
      if (data.count > skipAfter && Math.random() > reappear) return;
      document.documentElement.dataset.entrance = 'show';
    } catch {}
  })();
</script>

<div id="entrance" aria-hidden="true">
  <ParticleEntrance client:only="solid-js" />
</div>

<style>
  #entrance {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #f0ede4;
  }

  :global([data-theme="dark"]) #entrance {
    background: #141210;
  }

  :global([data-entrance="show"]) #entrance,
  :global([data-entrance="leaving"]) #entrance {
    display: block;
  }

  :global([data-entrance="leaving"]) #entrance {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease-out;
  }

  #entrance :global(astro-island) {
    display: block;
    width: 100%;
    height: 100%;
  }

  #entrance :global(.entrance-container) {
    width: 100%;
    height: 100%;
    position: relative;
  }

  #entrance :global(.entrance-hint) {
    position: absolute;
    bottom: 12%;
    left: 0;
    right: 0;
    text-align: center;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14px;
    letter-spacing: 0.1em;
    color: rgba(80, 75, 65, 0.5);
    pointer-events: none;
    user-select: none;
  }

  :global([data-theme="dark"]) #entrance :global(.entrance-hint) {
    color: rgba(200, 190, 175, 0.45);
  }
</style>
